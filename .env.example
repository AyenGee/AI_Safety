# Copy to .env (gitignored) and fill in. Loaded by intent_filter/config.py
# via pydantic-settings. NOT needed by default anymore - the project moved
# to OllamaLLMClient (free, local cluster inference, see cluster/setup.md).
# Only needed if you install the optional `.[anthropic]` extra and want to
# reproduce the historical Anthropic-model results with AnthropicLLMClient.

ANTHROPIC_API_KEY=
